generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF") // "OWNER" or "STAFF"
  createdAt DateTime @default(now())
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  barcode       String?  @unique
  category      String
  stock         Float    @default(0.0)
  location      String   @default("Store Front")
  unit          String
  price         Float    @default(0.0)
  purchasePrice Float  @default(0.0)
  hsnCode       String?
  taxRate       Float?
  status        String   @default("In Stock")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoiceItems         InvoiceItem[]
  purchaseItems        PurchaseItem[]
  quotationItems       QuotationItem[]
  directSaleItems      DirectSaleItem[]
  salesReturnItems     SalesReturnItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockLedger          StockLedger[]

  @@index([category])
  @@index([status])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  totalPurchases Float   @default(0.0)
  dueAmount     Float    @default(0.0)
  creditLimit   Float    @default(50000.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices Invoice[]
  quotations Quotation[]
  payments Payment[] @relation("CustomerPayments")
  salesReturns SalesReturn[]

  @@index([name])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  totalSupplied Float    @default(0.0)
  dueAmount     Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
  purchaseOrders PurchaseOrder[]
  payments Payment[] @relation("SupplierPayments")

  @@index([name])
}

model Invoice {
  id         String   @id @default(cuid())
  invoiceNo  String   @unique
  date       DateTime @default(now())
  subtotal   Float    @default(0.0)
  discount   Float    @default(0.0)
  tax        Float    @default(0.0)
  total      Float    @default(0.0)
  status     String   @default("PAID")
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  items InvoiceItem[]

  @@index([date])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  quantity  Float
  rate      Float
  purchaseRate Float @default(0.0)
  amount    Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Purchase {
  id         String   @id @default(cuid())
  purchaseNo String   @unique
  date       DateTime @default(now())
  total      Float    @default(0.0)
  status     String   @default("PAID")
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseItem[]

  @@index([date])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id        String  @id @default(cuid())
  quantity  Float
  rate      Float
  amount    Float

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  poNumber   String   @unique
  date       DateTime @default(now())
  total      Float    @default(0.0)
  status     String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  @@index([date])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id        String  @id @default(cuid())
  quantity  Float
  rate      Float
  amount    Float

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String
  date        DateTime @default(now())
  isDeleted   Boolean  @default(false)

  @@index([date])
  @@index([category])
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  type        String
  method      String
  date        DateTime @default(now())
  isDeleted   Boolean  @default(false)
  
  customerId  String?
  customer    Customer? @relation("CustomerPayments", fields: [customerId], references: [id])

  supplierId  String?
  supplier    Supplier? @relation("SupplierPayments", fields: [supplierId], references: [id])

  @@index([date])
  @@index([customerId])
  @@index([supplierId])
  @@index([type])
}

model Settings {
  id          String   @id @default("singleton")
  shopName    String   @default("Bharat Hydraulics")
  address     String   @default("")
  gstNumber   String   @default("")
  defaultTax  Float    @default(18.0)
}

model Quotation {
  id         String   @id @default(cuid())
  quoteNo    String   @unique
  date       DateTime @default(now())
  subtotal   Float    @default(0.0)
  discount   Float    @default(0.0)
  tax        Float    @default(0.0)
  total      Float    @default(0.0)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  items QuotationItem[]

  @@index([date])
  @@index([customerId])
}

model QuotationItem {
  id        String  @id @default(cuid())
  quantity  Float
  rate      Float
  amount    Float

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  userName  String
  userRole  String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model HistoricalRecord {
  id        String   @id @default(cuid())
  date      DateTime
  sales     Float    @default(0.0)
  profit    Float    @default(0.0)
  purchases Float    @default(0.0)
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
}

model DirectSale {
  id         String   @id @default(cuid())
  saleNo     String   @unique
  date       DateTime @default(now())
  subtotal   Float    @default(0.0)
  discount   Float    @default(0.0)
  tax        Float    @default(0.0)
  total      Float    @default(0.0)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  items DirectSaleItem[]

  @@index([date])
}

model DirectSaleItem {
  id        String  @id @default(cuid())
  quantity  Float
  rate      Float
  purchaseRate Float @default(0.0)
  amount    Float

  directSaleId String
  directSale   DirectSale @relation(fields: [directSaleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([directSaleId])
  @@index([productId])
}

model ProfitAllocation {
  id          String   @id @default(cuid())
  month       DateTime
  description String
  amount      Float
  date        DateTime @default(now())
}

model SalesReturn {
  id          String   @id @default(cuid())
  returnNo    String   @unique
  date        DateTime @default(now())
  totalAmount Float    @default(0.0)
  reason      String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  items       SalesReturnItem[]

  @@index([date])
  @@index([customerId])
}

model SalesReturnItem {
  id           String  @id @default(cuid())
  quantity     Float
  refundAmount Float

  returnId     String
  salesReturn  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  productId    String
  product      Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model StockAdjustment {
  id          String   @id @default(cuid())
  adjustNo    String   @unique
  date        DateTime @default(now())
  reason      String   // e.g., "Damage", "Audit", "Theft"
  notes       String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  items       StockAdjustmentItem[]

  @@index([date])
}

model StockAdjustmentItem {
  id                String  @id @default(cuid())
  quantityChanged   Float   // Can be negative or positive
  
  stockAdjustmentId String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)

  productId         String
  product           Product @relation(fields: [productId], references: [id])

  @@index([stockAdjustmentId])
  @@index([productId])
}

model StockLedger {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String   // SALE, PURCHASE, RETURN, ADJUSTMENT, INITIAL
  quantity    Float    // amount changed (+/-)
  balance     Float    // resulting stock balance
  referenceId String?  // Invoice ID, Purchase ID, etc.
  notes       String?
  
  productId   String
  product     Product @relation(fields: [productId], references: [id])

  @@index([date])
  @@index([productId])
  @@index([type])
}
